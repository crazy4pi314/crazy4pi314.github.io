{
  "name": "eleventy-theme-retro-garden",
  "version": "0.2.0",
  "description": "Retro Garden is an open source Eleventy theme that blends IndieWeb publishing habits with playful 90s personal-site energy.",
  "homepage": "https://retro-garden-eleventy-theme.vercel.app",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "11ty",
    "eleventy",
    "theme",
    "indieweb",
    "retro",
    "tailwindcss",
    "webc"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:css": "tailwindcss -i ./src/assets/css/theme.css -o ./_site/assets/css/theme.css --minify",
    "watch:css": "tailwindcss -i ./src/assets/css/theme.css -o ./_site/assets/css/theme.css --watch",
    "build:11ty": "eleventy",
    "dev:11ty": "eleventy --serve",
    "build": "npm run clean && npm run build:css && npm run build:11ty",
    "dev": "npm run build && run-p watch:css \"dev:11ty -- --incremental\"",
    "start": "npm run dev",
    "preview": "node scripts/serve-static.mjs",
    "validate:html": "html-validate \"_site/**/*.html\"",
    "validate:links": "node scripts/validate-links.mjs",
    "audit:a11y": "start-server-and-test \"node scripts/serve-static.mjs\" http://127.0.0.1:4173 \"pa11y-ci\"",
    "check": "npm run build && npm run validate:html && npm run validate:links && npm run audit:a11y"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@11ty/is-land": "^5.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "eleventy-plugin-og-image": "^4.3.0",
    "html-validate": "^11.9.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-attrs": "^4.5.0",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^4.1.1",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "slugify": "^1.6.9",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3"
  }
}

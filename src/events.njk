---
layout: layouts/base.njk
title: Events
description: Talks, workshops, panels, and community events featuring Sarah Kaiser.
eyebrow: events/index.njk
section: speaking archive
breadcrumbKey: Events
eleventyNavigation:
  key: Events
---
<div class="content-grid">
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">events.log</span>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Talks + appearances</p>
          <h1 class="section-title">Events</h1>
        </div>
      </div>
      <div class="archive-list">
        {% for item in collections.events %}
          <article class="archive-card">
            <p class="post-card__meta">
              <time datetime="{{ item.date | machineDate }}">{{ item.date | formatDate }}</time>
              {% if item.data.location %}<span aria-hidden="true">::</span><span>{{ item.data.location }}</span>{% endif %}
            </p>
            <h2 class="post-card__title"><a href="{{ item.url }}">{{ item.data.title }}</a></h2>
            {% if item.data.subtitle %}<p>{{ item.data.subtitle }}</p>{% endif %}
            {% if item.data.event %}<p class="archive-card__context">{{ item.data.event }}</p>{% endif %}
            {% set cardSlides = item.data.slides | slideLinks %}
            {% if item.data.video or cardSlides.length or item.data.code %}
              <nav class="resource-links" aria-label="Resources for {{ item.data.title }}{% if item.data.event %} ({{ item.data.event }}){% endif %}">
                {% if item.data.video %}<a class="resource-link" href="{{ item.data.video }}">Watch video</a>{% endif %}
                {% for slide in cardSlides %}
                  <a class="resource-link" href="{{ slide.url }}">{{ slide.label }}</a>
                {% endfor %}
                {% if item.data.code %}<a class="resource-link" href="{{ item.data.code }}">View code</a>{% endif %}
              </nav>
            {% endif %}
            {% set tags = item.data.tags | publicTags %}
            {% if tags.length %}
              <ul class="tag-list" aria-label="Event tags">
                {% for tag in tags %}<li><a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>{% endfor %}
              </ul>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </retro-panel>
  </div>
  <aside class="stack-rows">
    <retro-panel>
      <span slot="title">speaker.card</span>
      <div class="sidebar-block">
        <p class="eyebrow">Topics</p>
        <p class="home-note">Quantum computing, open source, developer tools, community building, science communication, and inclusive technology.</p>
        <div class="badge-wall">
          {% button88 "ABOUT", "/about/", "laser" %}
          {% button88 "BLOG", "/blog/", "laser-dark" %}
        </div>
      </div>
    </retro-panel>
  </aside>
</div>

<is-land on:idle webc:root="override">
  <button
    class="theme-toggle"
    type="button"
    data-theme-toggle
    aria-label="Theme: Auto. Switch to light theme."
  >
    <span class="theme-toggle__icon theme-toggle__icon--light" aria-hidden="true">
      <svg viewBox="0 0 16 16" shape-rendering="crispEdges" focusable="false">
        <path d="M7 0h2v3H7zM7 13h2v3H7zM0 7h3v2H0zM13 7h3v2h-3zM2 2h2v2H2zM12 2h2v2h-2zM2 12h2v2H2zM12 12h2v2h-2zM6 4h4v1h1v1h1v4h-1v1h-1v1H6v-1H5v-1H4V6h1V5h1z"></path>
      </svg>
    </span>
    <span class="theme-toggle__icon theme-toggle__icon--dark" aria-hidden="true">
      <svg viewBox="0 0 16 16" shape-rendering="crispEdges" focusable="false">
        <path d="M6 1h4v1H8v1H7v2H6v4h1v2h2v1h4v-1h2v2h-1v1h-2v1H6v-1H4v-1H3v-2H2V5h1V3h1V2h2z"></path>
      </svg>
    </span>
    <span class="theme-toggle__icon theme-toggle__icon--auto" aria-hidden="true">
      <svg viewBox="0 0 16 16" shape-rendering="crispEdges" focusable="false">
        <path fill-rule="evenodd" d="M1 1h14v11H1zM3 3v7h10V3z"></path>
        <path d="M7 12h2v2h3v1H4v-1h3z"></path>
      </svg>
    </span>
    <span class="theme-toggle__label" data-theme-label>Auto</span>
  </button>
  <template data-island="once" webc:raw>
    <script type="module" src="/assets/js/theme-toggle.js"></script>
  </template>
</is-land>

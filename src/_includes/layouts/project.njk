---
layout: layouts/base.njk
section: project
breadcrumbKey: Projects
---
<div class="content-grid content-grid--single">
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">projects/{{ page.fileSlug }}.md</span>
      <article class="entry-shell">
        <header class="entry-header project-header">
          <p class="eyebrow">{{ "Publication" if "publication" in tags else "Project" }}</p>
          <h1 class="entry-title">{% if emoji %}<span aria-hidden="true">{{ emoji }}</span> {% endif %}{{ title }}</h1>
          {% if summary %}<p class="entry-lead">{{ summary }}</p>{% endif %}
          {% set publicProjectTags = tags | publicTags %}
          {% if publicProjectTags.length %}
            <ul class="tag-list" aria-label="Project tags">
              {% for tag in publicProjectTags %}
                <li><a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </header>

        {% if image or externalUrl %}
          <pixel-divider></pixel-divider>
          <div class="project-feature">
            {% if image %}
              <img class="project-feature__image" src="{{ image }}" alt="Cover or preview for {{ title }}" eleventy:widths="320,640" sizes="(min-width: 48rem) 20rem, 80vw" />
            {% endif %}
            {% if externalUrl %}
              <p><a class="resource-link" href="{{ externalUrl }}">Visit project site</a></p>
            {% endif %}
          </div>
        {% endif %}

        <pixel-divider></pixel-divider>
        <div class="entry-body">{{ content | safe }}</div>
        <pixel-divider></pixel-divider>
        <a class="text-link" href="{% if 'publication' in tags %}/books/{% else %}/projects/{% endif %}">← {% if "publication" in tags %}All books{% else %}All projects{% endif %}</a>
      </article>
    </retro-panel>
  </div>
</div>

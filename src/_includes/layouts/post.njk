---
layout: layouts/base.njk
section: blog entry
---
{% set hasSidebar = postSidebar != false and site.features.postSidebars %}
<div class="content-grid{% if not hasSidebar %} content-grid--single{% endif %}">
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">{{ eyebrow or "blog-entry.md" }}</span>
      <article class="entry-shell h-entry">
        <header class="entry-header">
          {% if draft %}<p class="draft-notice" role="note">Draft: not listed, in feeds, or indexed</p>{% endif %}
          <p class="eyebrow">{{ section }}</p>
          <h1 class="entry-title p-name">{{ title }}</h1>
          <a class="u-url visually-hidden" href="{{ page.url | absoluteUrl(site.url) }}">Permalink for {{ title }}</a>
          {% if description %}
            <p class="entry-lead p-summary">{{ description }}</p>
          {% endif %}
          <div class="entry-meta">
            <time class="dt-published" datetime="{{ page.date | machineDate }}">{{ page.date | formatDate }}</time>
            <span aria-hidden="true">::</span>
            <span>{{ content | stripTags | readTime }}</span>
          </div>
          {% set tags = tags | publicTags %}
          {% if tags.length %}
            <ul class="tag-list" aria-label="Tags">
              {% for tag in tags %}
                <li><a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </header>
        <pixel-divider></pixel-divider>
        <div class="entry-body e-content">
          {{ content | safe }}
        </div>
        <pixel-divider></pixel-divider>
        {% if site.features.shareLinks %}
          {% include "partials/share-links.njk" %}
          <pixel-divider></pixel-divider>
        {% endif %}
        {% if site.features.webmentions %}
          {% include "partials/webmentions.njk" %}
          <pixel-divider></pixel-divider>
        {% endif %}
        <section class="author-panel p-author h-card">
          <p class="eyebrow">About the author</p>
          <h2 class="author-panel__title p-name">{{ site.author.name }}</h2>
          <p class="home-note p-note">{{ site.author.summary }}</p>
          <p class="home-note"><a class="u-url" href="{{ site.author.url }}">Visit the author’s home page</a></p>
          <div class="badge-wall">
            {% button88 "ABOUT", "/about/", "laser" %}
            {% button88 "RSS FEED", "/feed.xml", "laser-dark" %}
          </div>
        </section>
      </article>
    </retro-panel>
  </div>
  {% if hasSidebar %}
    <aside class="stack-rows">
      <retro-panel>
        <span slot="title">sidebar.sys</span>
        <div class="sidebar-block">
          <p class="eyebrow">Publishing hooks</p>
          <ul class="sidebar-list">
            <li>RSS and JSON feeds are wired in.</li>
            <li>OG images are generated at build time.</li>
            <li>Responsive images and static search are generated during the build.</li>
            <li>Optional webmentions and stronger author microformats are ready to configure.</li>
          </ul>
        </div>
        <pixel-divider></pixel-divider>
        <div class="sidebar-block">
          <p class="eyebrow">Quick links</p>
          <div class="badge-wall">
            {% button88 "ALL POSTS", "/blog/", "laser" %}
            {% button88 "TAG CLOUD", "/tags/", "laser-dark" %}
          </div>
        </div>
      </retro-panel>
    </aside>
  {% endif %}
</div>

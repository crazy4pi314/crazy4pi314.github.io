---
layout: layouts/base.njk
title: Blog year filter ideas
description: Three retro dropdown styles for filtering the blog archive by year.
eyebrow: blog-filter-ideas.njk
section: design sandbox
noindex: true
eleventyExcludeFromCollections: true
---
{% set years = [] %}
{% for post in collections.posts %}
  {% set y = post.date.getFullYear() %}
  {% if not (y in years) %}{% set years = (years.push(y), years) %}{% endif %}
{% endfor %}
<div class="content-grid">
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">archive.log</span>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Design sandbox</p>
          <h1 class="section-title">Filter the blog by year</h1>
        </div>
      </div>
      <p>
        Pick a year in any of the three menus on the right. They all control this list, so you can
        compare how each one feels. On the real blog page, the filter would show every post, not just one page of three.
      </p>
      <p class="year-filter-status" id="year-filter-status" role="status">Showing all {{ collections.posts.length }} posts</p>
      <div class="panel-grid" id="year-filter-posts">
        {% for post in collections.posts %}
          <article class="post-card h-entry" data-year="{{ post.date.getFullYear() }}">
            <p class="post-card__meta">
              <time class="dt-published" datetime="{{ post.date | machineDate }}">{{ post.date | formatDate }}</time>
              <span aria-hidden="true">::</span>
              <span>{{ post.templateContent | stripTags | readTime }}</span>
            </p>
            <h2 class="post-card__title">
              <a class="p-name u-url" href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            <p>{{ post.data.description }}</p>
          </article>
        {% endfor %}
      </div>
    </retro-panel>
  </div>

  <aside class="stack-rows">
    <retro-panel>
      <span slot="title">topics.txt</span>

      <div class="year-filter-stack">
      <div class="sidebar-block">
        <p class="eyebrow">A ::  Beveled desktop select</p>
        <label class="year-select-95">
          <span class="year-select-95__label">Year:</span>
          <span class="year-select-95__box">
            <select id="year-a" class="year-filter-control">
              <option value="all">All years</option>
              {% for y in years %}<option value="{{ y }}">{{ y }}</option>{% endfor %}
            </select>
            <span class="year-select-95__arrow" aria-hidden="true">▼</span>
          </span>
        </label>
      </div>

      <pixel-divider></pixel-divider>

      <div class="sidebar-block">
        <p class="eyebrow">B :: Terminal prompt</p>
        <label class="year-select-term">
          <span class="year-select-term__prompt" aria-hidden="true">C:\BLOG&gt;</span>
          <span class="visually-hidden">Filter posts by year</span>
          <span class="year-select-term__cmd" aria-hidden="true">dir /year:</span>
          <select id="year-b" class="year-filter-control">
            <option value="all">*</option>
            {% for y in years %}<option value="{{ y }}">{{ y }}</option>{% endfor %}
          </select>
          <span class="year-select-term__caret" aria-hidden="true">_</span>
        </label>
      </div>

      <pixel-divider></pixel-divider>

      <div class="sidebar-block">
        <p class="eyebrow">C :: Pop-up window menu</p>
        <details class="year-menu">
          <summary class="year-menu__button">
            <span>Year: <strong class="year-menu__current">All</strong></span>
            <span aria-hidden="true">▾</span>
          </summary>
          <div class="year-menu__window">
            <div class="year-menu__bar" aria-hidden="true">
              <span>select_year.exe</span><span>× </span>
            </div>
            <ul class="year-menu__list">
              <li><button type="button" class="year-menu__option" data-year="all" aria-pressed="true">All years</button></li>
              {% for y in years %}
                <li><button type="button" class="year-menu__option" data-year="{{ y }}" aria-pressed="false">{{ y }}</button></li>
              {% endfor %}
            </ul>
          </div>
        </details>
      </div>

      <pixel-divider></pixel-divider>

      <div class="sidebar-block">
        <p class="eyebrow">Popular tags</p>
        <ul class="tag-list">
          {% for tag in collections.tagList %}
            <li><a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
          {% endfor %}
        </ul>
      </div>
      </div>
    </retro-panel>
  </aside>
</div>

<script>
  (() => {
    const posts = [...document.querySelectorAll("#year-filter-posts [data-year]")];
    const status = document.getElementById("year-filter-status");
    const selects = [...document.querySelectorAll(".year-filter-control")];
    const options = [...document.querySelectorAll(".year-menu__option")];
    const current = document.querySelector(".year-menu__current");
    const menu = document.querySelector(".year-menu");

    const apply = (year) => {
      let shown = 0;
      for (const post of posts) {
        const match = year === "all" || post.dataset.year === year;
        post.hidden = !match;
        if (match) shown += 1;
      }
      selects.forEach((s) => { s.value = year; });
      options.forEach((o) => o.setAttribute("aria-pressed", String(o.dataset.year === year)));
      current.textContent = year === "all" ? "All" : year;
      status.textContent = year === "all"
        ? `Showing all ${shown} posts`
        : `Showing ${shown} post${shown === 1 ? "" : "s"} from ${year}`;
    };

    selects.forEach((s) => s.addEventListener("change", () => apply(s.value)));
    options.forEach((o) => o.addEventListener("click", () => {
      apply(o.dataset.year);
      menu.open = false;
      menu.querySelector("summary").focus();
    }));
  })();
</script>

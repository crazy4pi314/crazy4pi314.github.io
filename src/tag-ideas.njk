---
layout: layouts/base.njk
title: Popular tag ideas
description: Four ways to tame the popular tags panel.
eyebrow: tag-ideas.njk
section: design sandbox
noindex: true
eleventyExcludeFromCollections: true
topCount: 10
---
{% set allTags = collections.tagCounts %}
{% set maxCount = allTags[0].count if allTags.length else 1 %}
{% set grouped = [] %}
{% for g in tagGroups %}{% set grouped = (grouped.push.apply(grouped, g.tags), grouped) %}{% endfor %}

{% macro pill(t, withCount=true) %}
  <li><a class="tag-pill" href="/tags/{{ t.tag | slugify }}/">{{ t.tag }}{% if withCount %} <span class="tag-count"><span class="visually-hidden">(</span>{{ t.count }}<span class="visually-hidden">)</span></span>{% endif %}</a></li>
{% endmacro %}

<div class="stack-rows">
  <retro-panel>
    <span slot="title">tag-ideas.log</span>
    <div class="section-heading">
      <div>
        <p class="eyebrow">Design sandbox</p>
        <h1 class="section-title">Taming the tag list</h1>
      </div>
    </div>
    <p>
      {{ allTags.length }} tags across posts, events, talks, and books. Each box below is sized like the
      blog sidebar so you can compare them. Counts include every page that uses the tag.
    </p>
  </retro-panel>

  <div class="tag-ideas-grid">
    <retro-panel>
      <span slot="title">A :: top10.txt</span>
      <div class="sidebar-block">
        <p class="eyebrow">Popular tags</p>
        <ul class="tag-list">
          {% for t in allTags %}{% if loop.index <= topCount %}{{ pill(t) }}{% endif %}{% endfor %}
        </ul>
        <details class="tag-more">
          <summary class="tag-more__toggle">
            <span class="tag-more__closed">[+] Show all {{ allTags.length }} tags</span>
            <span class="tag-more__open">[−] Show fewer</span>
          </summary>
          <ul class="tag-list">
            {% for t in allTags %}{% if loop.index > topCount %}{{ pill(t) }}{% endif %}{% endfor %}
          </ul>
        </details>
      </div>
    </retro-panel>

    <retro-panel>
      <span slot="title">B :: cloud.txt</span>
      <div class="sidebar-block">
        <p class="eyebrow">Tag cloud</p>
        <ul class="tag-list tag-cloud">
          {% for t in allTags | sort(false, false, "tag") %}
            {% set tier = ((t.count / maxCount) * 3) | round(0, "ceil") %}
            <li><a class="tag-pill tag-cloud--{{ tier }}" href="/tags/{{ t.tag | slugify }}/">{{ t.tag }}<span class="visually-hidden"> ({{ t.count }})</span></a></li>
          {% endfor %}
        </ul>
      </div>
    </retro-panel>

    <retro-panel>
      <span slot="title">C :: folders.txt</span>
      <div class="sidebar-block">
        <p class="eyebrow">Browse by topic</p>
        <ul class="tag-folders">
          {% for g in tagGroups %}
            {% set groupTotal = 0 %}
            {% for t in allTags %}{% if t.tag in g.tags %}{% set groupTotal = groupTotal + 1 %}{% endif %}{% endfor %}
            <li>
              <details class="tag-folder"{% if loop.first %} open{% endif %}>
                <summary><span class="tag-folder__icon" aria-hidden="true"></span>{{ g.name }}/ <span class="tag-folder__count">{{ groupTotal }}</span></summary>
                <ul class="tag-list">
                  {% for t in allTags %}{% if t.tag in g.tags %}{{ pill(t) }}{% endif %}{% endfor %}
                </ul>
              </details>
            </li>
          {% endfor %}
          {% set miscTotal = 0 %}
          {% for t in allTags %}{% if not (t.tag in grouped) %}{% set miscTotal = miscTotal + 1 %}{% endif %}{% endfor %}
          {% if miscTotal %}
            <li>
              <details class="tag-folder">
                <summary><span class="tag-folder__icon" aria-hidden="true"></span>misc/ <span class="tag-folder__count">{{ miscTotal }}</span></summary>
                <ul class="tag-list">
                  {% for t in allTags %}{% if not (t.tag in grouped) %}{{ pill(t) }}{% endif %}{% endfor %}
                </ul>
              </details>
            </li>
          {% endif %}
        </ul>
      </div>
    </retro-panel>

    <retro-panel>
      <span slot="title">D :: find.exe</span>
      <div class="sidebar-block tag-find" data-top="{{ topCount }}">
        <p class="eyebrow">Popular tags</p>
        <label class="tag-find__prompt">
          <span aria-hidden="true">C:\TAGS&gt;</span>
          <span class="visually-hidden">Find a tag</span>
          <input type="search" class="tag-find__input" placeholder="find..." autocomplete="off">
        </label>
        <ul class="tag-list">
          {% for t in allTags %}{{ pill(t) }}{% endfor %}
        </ul>
        <p class="tag-find__status" role="status"></p>
      </div>
    </retro-panel>
  </div>
</div>

<script>
  (() => {
    const box = document.querySelector(".tag-find");
    const input = box.querySelector(".tag-find__input");
    const items = [...box.querySelectorAll(".tag-list li")];
    const status = box.querySelector(".tag-find__status");
    const top = Number(box.dataset.top);

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((li, i) => {
        const match = q ? li.textContent.toLowerCase().includes(q) : i < top;
        li.hidden = !match;
        if (match) shown += 1;
      });
      status.textContent = q
        ? `${shown} tag${shown === 1 ? "" : "s"} match "${q}"`
        : `Top ${top} of ${items.length} tags. Type to search all.`;
    };

    input.addEventListener("input", apply);
    apply();
  })();
</script>

---
layout: layouts/base.njk
title: Home
description: The home page for Retro Garden, a retro IndieWeb-flavored Eleventy theme.
eyebrow: index.html
section: welcome screen
---
<div class="content-grid">
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">home.exe</span>
      <section class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">Retro Garden // IndieWeb x 90s personal site mixtape</p>
          <h1 class="hero-title">A garden for dial-up charm and modern publishing parts.</h1>
          <div class="hero-lead">
            {{ site.heroLead | renderMarkdown | safe }}
          </div>
          <div class="badge-wall hero-badges" role="group" aria-label="Feeds and profiles">
            {% for badge in site.badges %}
              {% if not badge.feature or site.features[badge.feature] %}{% button88 badge.label, badge.url, badge.accent %}{% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="status-grid">
          <div class="status-chip">
            <strong>View source friendly</strong>
            <span>Readable templates, markdown posts, and shortcodes you can actually edit.</span>
          </div>
          <div class="status-chip">
            <strong>Accessible by default</strong>
            <span>Skip links, strong focus rings, reduced motion guards, and contrast that holds up.</span>
          </div>
          <div class="status-chip">
            <strong>Personal-site energy</strong>
            <span>Badge walls, retro chrome, webring vibes, and room for personality over polish.</span>
          </div>
        </div>
      </section>
    </retro-panel>

    <retro-panel>
      <span slot="title">blog/</span>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest entries</p>
          <h2 class="section-title">Fresh notes from the lab</h2>
        </div>
        <a class="text-link" href="/blog/">Browse the archive</a>
      </div>
      <div class="panel-grid">
        {% for post in collections.posts | limit(3) %}
          <article class="post-card h-entry">
            <p class="post-card__meta">
              <time class="dt-published" datetime="{{ post.date | machineDate }}">{{ post.date | formatDate }}</time>
              <span aria-hidden="true">::</span>
              <span>{{ post.templateContent | stripTags | readTime }}</span>
            </p>
            <h3 class="post-card__title">
              <a class="p-name u-url" href="{{ post.url }}">{{ post.data.title }}</a>
            </h3>
            <p>{{ post.data.description }}</p>
            {% set tags = post.data.tags | publicTags %}
            {% if tags.length %}
              <ul class="tag-list" aria-label="Post tags">
                {% for tag in tags %}
                  <li><a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </retro-panel>

    <retro-panel>
      <span slot="title">palettes.css</span>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Built-out palettes</p>
          <h2 class="section-title">Laser light and dark</h2>
        </div>
      </div>
      <div class="palette-grid">
        {% for palette in site.palettes %}
          <article class="palette-card palette-card--{{ palette.slug }}">
            <p class="eyebrow">{{ palette.vibe }}</p>
            <h3 class="post-card__title">{{ palette.name }}</h3>
            <p>{{ palette.note }}</p>
            <div class="palette-card__window">
              <div class="palette-card__bar">
                <span>{{ palette.slug }}.theme</span>
                <div class="palette-card__dots"><span></span><span></span><span></span></div>
              </div>
              <div class="palette-card__body">
                <div class="palette-swatch-grid">
                  {% for swatch in palette.swatches %}
                    <div class="palette-swatch">
                      <span class="palette-swatch__chip" style="background: {{ swatch.value }}"></span>
                      <strong>{{ swatch.label }}</strong>
                      <code>{{ swatch.value }}</code>
                    </div>
                  {% endfor %}
                </div>
                <div class="badge-wall">
                  {% button88 "RSS FEED", "/feed.xml", palette.slug %}
                </div>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
    </retro-panel>

  </div>

  <aside class="stack-rows">

    {% if site.features.sampleContent %}<retro-panel>
      <span slot="title">toolbox.log</span>
      <div class="sidebar-block">
        <p class="eyebrow">Some of my favorite OSS projects</p>
        <ul class="toolbox-list">
          {% for item in toolbox %}
            <li class="toolbox-list__item">
              <div>
                <p class="toolbox-list__name">
                  <a class="stack-name" href="{{ item.url }}">{{ item.name }}</a>
                  {% if item.repo %}
                    <a class="repo-link" href="{{ item.repo }}" aria-label="{{ item.name }} on GitHub" title="{{ item.name }} on GitHub">
                      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    </a>
                  {% endif %}
                </p>
                <p class="stack-description">{{ item.description }}</p>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </retro-panel>{% endif %}

    {% if site.features.sampleContent %}<retro-panel>
      <span slot="title">neighbors.net</span>
      <div class="section-heading">
        <div>
          <h2 class="section-title">Interesting people who say interesting things</h2>
        </div>
      </div>
      <ul class="mini-list">
        {% for item in site.neighborhood %}
          <li>
            <a href="{{ item.url }}">{{ item.name }}</a>
            <p>{{ item.note }}</p>
          </li>
        {% endfor %}
      </ul>
    </retro-panel>{% endif %}

  </aside>
</div>

---
layout: layouts/base.njk
title: Home
description: "Dr. Sarah Kaiser's personal homepage: quantum software, books, talks, lasers, and open source."
eyebrow: index.html
section: welcome screen
---
<div class="content-grid">
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">home.exe</span>
      <section class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">{{ site.hero.kicker }}</p>
          <h1 class="hero-title">{{ site.hero.title }}</h1>
          <div class="hero-lead">
            {{ site.heroLead | renderMarkdown | safe }}
          </div>
          <div class="badge-wall hero-badges" role="group" aria-label="Feeds and profiles">
            {% for badge in site.badges %}
              {% if not badge.feature or site.features[badge.feature] %}{% button88 badge.label, badge.url, badge.accent %}{% endif %}
            {% endfor %}
          </div>
        </div>
        {% if site.hero.photo %}
          <figure class="hero-photo">
            <img src="{{ site.hero.photo.src }}" alt="{{ site.hero.photo.alt }}" width="960" height="960" sizes="(min-width: 48rem) 16rem, 70vw" loading="eager" fetchpriority="high">
          </figure>
        {% endif %}
        <div class="status-grid">
          {% for chip in site.hero.chips %}
            <div class="status-chip">
              <strong>{% if chip.url %}<a href="{{ chip.url }}">{{ chip.title }}</a>{% else %}{{ chip.title }}{% endif %}</strong>
              <span>{{ chip.text }}</span>
            </div>
          {% endfor %}
        </div>
      </section>
    </retro-panel>

    <retro-panel>
      <span slot="title">blog/</span>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest entries</p>
          <h2 class="section-title">Fresh notes from the lab</h2>
        </div>
        <a class="text-link" href="/blog/">Browse the archive</a>
      </div>
      <div class="panel-grid">
        {% for post in collections.blogFeed | limit(3) %}
          <article class="post-card feed-card feed-card--{{ post.data | feedType }} h-entry">
            {% set feedHeadingLevel = 3 %}
            {% include "partials/feed-card.njk" %}
          </article>
        {% endfor %}
      </div>
    </retro-panel>

  </div>

  <aside class="stack-rows">

    {% if site.features.sampleContent %}<retro-panel>
      <span slot="title">toolbox.log</span>
      <div class="sidebar-block">
        <p class="eyebrow">Some of my favorite OSS projects</p>
        <ul class="toolbox-list">
          {% for item in site.stack %}
            <li class="toolbox-list__item">
              <div>
                <p class="toolbox-list__name">
                  <span class="stack-name">{{ item.name }}</span>
                  {% if item.url %}
                    <a class="repo-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.name }} on GitHub (opens in a new tab)" title="{{ item.name }} on GitHub">
                      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    </a>
                  {% endif %}
                </p>
                <p class="stack-description">{{ item.detail }}</p>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </retro-panel>{% endif %}

    {% if site.features.sampleContent %}<retro-panel>
      <span slot="title">neighbors.net</span>
      <div class="section-heading">
        <div>
          <h2 class="section-title">Interesting people who say interesting things</h2>
        </div>
      </div>
      <ul class="mini-list">
        {% for item in site.neighborhood %}
          <li>
            <a href="{{ item.url }}">{{ item.name }}</a>
            <p>{{ item.note }}</p>
          </li>
        {% endfor %}
      </ul>
    </retro-panel>{% endif %}

  </aside>
</div>

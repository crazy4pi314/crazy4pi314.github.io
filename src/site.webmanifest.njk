---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
skipOgImage: true
---
{
  "name": {{ site.title | json | safe }},
  "short_name": {{ site.title | json | safe }},
  "description": {{ site.description | json | safe }},
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f3f4f7",
  "theme_color": "#f3f4f7",
  "icons": [
    {
      "src": "/assets/images/logo/laser-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/assets/images/logo/laser-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/logo/laser-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}

---
layout: layouts/base.njk
title: Blog
description: Long-form posts, field notes, and other dispatches from this handmade corner of the web.
eyebrow: blog/index.njk
section: archive
breadcrumbKey: Blog
pagination:
  data: collections.posts
  size: 3
  alias: blogPosts
permalink: "{% if pagination.pageNumber == 0 %}/blog/index.html{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/index.html{% endif %}"
---
{% set years = [] %}
{% for post in collections.posts %}
  {% set y = post.date.getFullYear() %}
  {% if not (y in years) %}{% set years = (years.push(y), years) %}{% endif %}
{% endfor %}
<div class="content-grid" data-year-filter>
  <div class="stack-rows">
    <retro-panel>
      <span slot="title">archive.log</span>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Blog archive</p>
          <h1 class="section-title">My unscientific lab notebook</h1>
        </div>
        <div class="section-heading__actions" role="group" aria-label="Subscribe to the blog">
          {% button88 "RSS FEED", "/feed.xml", "laser-dark" %}
          {% button88 "JSON FEED", "/feed.json", "laser-dark" %}
        </div>
      </div>
      <p class="year-filter-status" role="status" hidden></p>
      <div class="panel-grid">
        {% for post in collections.posts %}
          {% set onPage = (loop.index0 / pagination.size) | int == pagination.pageNumber %}
          <article class="post-card h-entry" data-year="{{ post.date.getFullYear() }}" data-current-page="{{ onPage }}"{% if not onPage %} hidden data-pagefind-ignore="all"{% endif %}>
            <p class="post-card__meta">
              <time class="dt-published" datetime="{{ post.date | machineDate }}">{{ post.date | formatDate }}</time>
              <span aria-hidden="true">::</span>
              <span>{{ post.templateContent | stripTags | readTime }}</span>
            </p>
            <h2 class="post-card__title">
              <a class="p-name u-url" href="{{ post.url }}">{{ post.data.title }}</a>
            </h2>
            <p>{{ post.data.description }}</p>
            {% set tags = post.data.tags | publicTags %}
            {% if tags.length %}
              <ul class="tag-list" aria-label="Post tags">
                {% for tag in tags %}
                  <li><span class="tag-pill">{{ tag }}</span></li>
                {% endfor %}
              </ul>
            {% endif %}
          </article>
        {% endfor %}
      </div>
      {% if pagination.pages.length > 1 %}
        <nav class="pagination" aria-label="Blog pagination">
          <div>
            {% if pagination.href.previous %}<a class="text-link" href="{{ pagination.href.previous }}">← Newer posts</a>{% endif %}
          </div>
          <span class="pagination__status">Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
          <div>
            {% if pagination.href.next %}<a class="text-link" href="{{ pagination.href.next }}">Older posts →</a>{% endif %}
          </div>
        </nav>
      {% endif %}
    </retro-panel>
  </div>
  <aside class="stack-rows">
    <retro-panel>
      <span slot="title">topics.txt</span>
      <div class="year-filter-stack">
      <div class="sidebar-block year-filter-block" hidden>
        <p class="eyebrow">Filter by year</p>
        <label class="year-select-95">
          <span class="year-select-95__label">Year:</span>
          <span class="year-select-95__box">
            <select class="year-filter-control">
              <option value="all">All</option>
              {% for y in years %}<option value="{{ y }}">{{ y }}</option>{% endfor %}
            </select>
            <span class="year-select-95__arrow" aria-hidden="true">▼</span>
          </span>
        </label>
      </div>
      <div class="sidebar-block">
        <p class="eyebrow">Popular tags</p>
        <ul class="tag-list">
          {% for t in collections.tagCounts %}{% if loop.index <= 10 %}
            <li><a class="tag-pill" href="/tags/{{ t.tag | slugify }}/">{{ t.tag }}</a></li>
          {% endif %}{% endfor %}
        </ul>
      </div>
      <div class="sidebar-block">
        <p class="eyebrow">Browse by topic</p>
        {% set grouped = [] %}
        {% for g in tagGroups %}{% set grouped = (grouped.push.apply(grouped, g.tags), grouped) %}{% endfor %}
        {% set folders = [] %}
        {% for g in tagGroups %}
          {% set folderTags = [] %}
          {% for t in collections.tagCounts | sort(false, false, "tag") %}{% if t.tag in g.tags %}{% set folderTags = (folderTags.push(t.tag), folderTags) %}{% endif %}{% endfor %}
          {% if folderTags.length %}{% set folders = (folders.push({ name: g.name, tags: folderTags }), folders) %}{% endif %}
        {% endfor %}
        {% set miscTags = [] %}
        {% for t in collections.tagCounts | sort(false, false, "tag") %}{% if not (t.tag in grouped) %}{% set miscTags = (miscTags.push(t.tag), miscTags) %}{% endif %}{% endfor %}
        {% if miscTags.length %}{% set folders = (folders.push({ name: "misc", tags: miscTags }), folders) %}{% endif %}
        <ul class="tag-folders">
          {% for f in folders %}
            <li>
              <details class="tag-folder">
                <summary><span class="tag-folder__icon" aria-hidden="true"></span>{{ f.name }}/ <span class="tag-folder__count">{{ f.tags.length }}<span class="visually-hidden"> tags</span></span></summary>
                <ul class="tag-list">
                  {% for tag in f.tags %}
                    <li><a class="tag-pill" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
                  {% endfor %}
                </ul>
              </details>
            </li>
          {% endfor %}
        </ul>
      </div>
      </div>
    </retro-panel>
  </aside>
</div>
<script type="module" src="/assets/js/year-filter.js"></script>
